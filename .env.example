# Application Settings
# development 使用 Flask；production 使用 IIS + ARR + Waitress。
APP_ENV=development
APP_DEBUG=true

# Database Configuration
SQLALCHEMY_DATABASE_URI=mssql+pyodbc://user:password@127.0.0.1:1433/your_database?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Security & Session Settings
# 請使用指令產生安全密鑰： uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-only-change-before-production

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=28800

# Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

PUBLIC_HTTP_PORT=5000
BACKEND_BASE_PORT=51001
APP_WORKERS=1

WAITRESS_HOST=127.0.0.1
WAITRESS_THREADS=8
WAITRESS_BACKLOG=256
WAITRESS_CONNECTION_LIMIT=256
WAITRESS_CHANNEL_TIMEOUT=300

TRUSTED_PROXY=127.0.0.1
PROXY_COUNT=1

# LLM Configuration
# --- Ollama ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://120.113.70.238:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:26b

# --- OpenAI ---
# 使用 OpenAI，將 LLM_PROVIDER 改為 openai，並填入 API 金鑰
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini