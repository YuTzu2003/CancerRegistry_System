FLASK_PORT=5000
SQLALCHEMY_DATABASE_URI=mssql+pyodbc://user:password@127.0.0.1:1433/Notebook?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# 請使用指令產生安全密鑰： uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-only-change-before-production
# 請在正式環境使用每個環境專屬的隨機值，切勿提交實際 .env 檔案。

# LLM Configuration (Ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://120.113.70.238:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:26b

