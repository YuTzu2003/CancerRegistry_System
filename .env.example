# Gmail SMTP account-recovery settings. Do not commit real values.
GMAIL_SENDER_EMAIL=
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_APP_PASSWORD=
EMAIL_VERIFICATION_ENABLED=false
PASSWORD_CODE_MINUTES=10
VERIFICATION_CODE_RESEND_SECONDS=60
VERIFICATION_CODE_MAX_PER_HOUR=5
APP_ENV=development
APP_DEBUG=true
SQLALCHEMY_DATABASE_URI=mssql+pyodbc://YLH:YLH@127.0.0.1:1433/Hospital_data?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Security & Session Settings
# 請使用指令產生安全密鑰： uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-only-change-before-production

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=28800

FLASK_HOST=127.0.0.1
FLASK_PORT=5000

PUBLIC_HTTP_PORT=5000
BACKEND_BASE_PORT=51001
APP_WORKERS=1

# --- SQL Server connection budget -------------------------------------------
# Each process uses the SQLAlchemy pool in modules/services/db.py: up to
# pool_size=10 persistent connections (opened on demand, not at startup) plus
# up to max_overflow=10 burst = at most 20 concurrent connections per process.
# Peak total DB connections (size SQL Server 'max connections' above this):
#   (APP_WORKERS + LLM_WORKERS) * 20  +  a few for admin/backup
# WAITRESS_THREADS caps concurrent web requests inside one app process; those
# requests already draw from that process's 20-connection ceiling, so threads
# above the ceiling queue on the pool rather than adding new DB connections.
# Keep WAITRESS_THREADS <= the pool ceiling. Start at 8, load-test before 16.
# ----------------------------------------------------------------------------
WAITRESS_HOST=127.0.0.1
WAITRESS_THREADS=8
WAITRESS_BACKLOG=256
WAITRESS_CONNECTION_LIMIT=256
WAITRESS_CHANNEL_TIMEOUT=600

# Annual report PBIP project template (the .Report and .SemanticModel folders must stay beside it).
PBI_PROJECT_TEMPLATE_PATH=D:\PBIShare\powerbi_dataset.pbip

# Annual report PBIP project template (the .Report and .SemanticModel folders must stay beside it).
PBI_PROJECT_TEMPLATE_PATH=D:\PBIShare\powerbi_dataset.pbip

TRUSTED_PROXY=127.0.0.1
PROXY_COUNT=1

# LLM Configuration
# --- Ollama ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ip:11434/v1
LLM_API_KEY=ollama
MODEL=gemma4:26b
LLM_TIMEOUT_SECONDS=180
LLM_WORKERS=1
# Background annual-report export workers (TaskType='export_render'). One is
# plenty; registered as CancerRegistrySystem-EXPORT-NN by register-autostart.ps1.
EXPORT_WORKERS=1
# Each export worker keeps one Chromium alive and reuses it across exports
# (saves ~2.5s driver startup each), recycling it after this many renders to
# cap memory. Optional; default 50.
# EXPORT_BROWSER_MAX_RENDERS=50

